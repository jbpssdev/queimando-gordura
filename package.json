{
  "name": "queimando-gordura",
  "version": "1.0.0",
  "private": true,
  "description": "Fundação da plataforma Queimando Gordura 1.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run start --workspace frontend",
    "dev:backend": "npm run start:dev --workspace backend",
    "dev": "concurrently --kill-others --names frontend,backend \"npm run dev:frontend\" \"npm run dev:backend\"",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "test:e2e": "npm run test:e2e --workspace backend",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:e2e && npm run build && npm run test:smoke && npm run test:rules",
    "emulators": "node scripts/emulators.mjs",
    "test:smoke": "playwright test",
    "test:rules": "node scripts/emulators.mjs --test"
  },
  "devDependencies": {
    "prettier": "3.8.5",
    "firebase-tools": "15.34.0",
    "concurrently": "10.0.6",
    "@playwright/test": "1.64.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "vitest": "5.0.5",
    "@vitest/coverage-v8": "5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "undici@>=7.0.0 <7.30.1": "7.30.1",
    "nx": "23.3.0",
    "@nx/eslint": "23.3.0",
    "@nx/devkit": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/web": "23.3.0",
    "@nx/workspace": "23.3.0",
    "@nx/angular": "23.3.0"
  }
}
