NODE_ENV=development
PORT=3100
CORS_ORIGINS=http://localhost:4200
# Firebase desativado por padrão; habilite explicitamente emulação ou nuvem.
FIREBASE_MODE=disabled
# Para emulação local: FIREBASE_MODE=emulator e as três variáveis abaixo.
# FIREBASE_PROJECT_ID=demo-queimando-gordura
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Produção futura: FIREBASE_MODE=production, projeto real e caminho absoluto externo.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secrets/service-account.json
