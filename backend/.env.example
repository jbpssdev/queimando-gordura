NODE_ENV=development
PORT=3100
CORS_ORIGINS=http://localhost:4200

# Modos Firebase: disabled | emulator | production
FIREBASE_MODE=disabled

# ==============================================================================
# AMBIENTE 1: Emuladores Locais (Firebase Emulator Suite)
# ==============================================================================
# FIREBASE_MODE=emulator
# FIREBASE_PROJECT_ID=demo-queimando-gordura
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ==============================================================================
# AMBIENTE 2: Firebase Cloud de Desenvolvimento (Projeto Real Isolado)
# ==============================================================================
# FIREBASE_MODE=production
# FIREBASE_PROJECT_ID=queimando-gordura-783e4
# Opção A: Application Default Credentials (recomendado):
# FIREBASE_USE_ADC=true
# ADC pode usar um arquivo authorized_user externo via GOOGLE_APPLICATION_CREDENTIALS.
# Com FIREBASE_USE_ADC=true o SDK faz a resolução ADC, sem interpretar o arquivo como cert().
# Opção B: Chave de conta de serviço mantida fora do repositório (caminho absoluto):
# GOOGLE_APPLICATION_CREDENTIALS=C:/secrets/queimando-gordura-dev-sa.json
# Para autorizar testes controlados contra este projeto:
# FIREBASE_ALLOW_CLOUD_TEST=true
# FIREBASE_WEB_API_KEY=<apiKey pública do app Web DEV>
# Os scripts Cloud carregam .env.cloud.local (ignorado); não habilite produção neste arquivo.

# ==============================================================================
# AMBIENTE 3: Produção Futura (Outro projeto, isolado e sem testes destrutivos)
# ==============================================================================
# NODE_ENV=production
# PORT=3100
# CORS_ORIGINS=https://app.queimandogordura.com.br
# FIREBASE_MODE=production
# FIREBASE_PROJECT_ID=queimando-gordura-prod
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/prod-service-account.json
